  "puzzles": [
    {
      "id": "P01",
      "room": "SLU02",
      "flag": "SLUICE_OPEN",
      "goal_clues": "Restore bridge. Damaged plinth: center conductor last; relief: Root Arch before Hanging Bell; pulse confirms.",
      "solution": "Root Arch → Hanging Bell → Split Stone (center).",
      "result": "Bridge lifts, opens Warden route and HUN shortcut; wrong order resets local sequence and highlights last invalid conductor."
    },
    {
      "id": "P02",
      "room": "CAM03",
      "flag": "MAP_ALIGNED",
      "goal_clues": "Align Dawn map with bell, split rock and camp arch; bell visible from OUT03; sketch in CAM02.",
      "solution": "Pin bell to east, rock to west, arch to camp origin; accept maintenance link to SLU01.",
      "result": "Map route appears; wrong alignment shows landmark mismatch."
    },
    {
      "id": "P03",
      "room": "REL02",
      "flag": "WORKS_POWER",
      "goal_clues": "Power maintenance receiver. Wall flow diagram and arrows show source→relay→receiver; blocked archive branch.",
      "solution": "Connect source to service relay, relay to receiver; leave dead archive branch isolated.",
      "result": "Door opens to REL03; disconnected receiver icon or overload alarm on mistake."
    },
    {
      "id": "P04",
      "room": "SUR02",
      "flag": "ARCHIVE_ALIGNED",
      "goal_clues": "Identify survey archive. Three plates show receiver, archive, anchor symbols; service note requires power before record before route.",
      "solution": "Receiver → Archive → Anchor.",
      "result": "Access SUR03; incorrect order resets plates; critical map automatically recorded on entry."
    },
    {
      "id": "P05",
      "room": "WAR02",
      "flag": "TOPOLOGY_ALIGNED",
      "goal_clues": "Historical map shows three doors; two unstable anchors pulse irregularly. Current landmarks and anchor shape match stable route.",
      "solution": "Choose paired diamond anchor with continuous pulse (middle door in initial layout).",
      "result": "WAR03 opens; wrong doors loop safely to WAR02 with mismatched landmark feedback."
    },
    {
      "id": "P06",
      "room": "RES02",
      "flag": "RESERVOIR_STABLE",
      "goal_clues": "Power vault and preserve safe release. Source feeds three toggles; storage indicator full.",
      "solution": "Vault power ON, Release ON, Full storage OFF.",
      "result": "Reservoir stabilizes, local fauna reduced, arena accessible; full storage alarms, no fatal penalty."
    },
    {
      "id": "P07",
      "room": "REW01",
      "flag": "KEEPER_EXPOSED",
      "goal_clues": "Keeper shield fed by paired conductors; diagram marks maintenance isolators.",
      "solution": "Disable left and right isolators; lock offline for encounter.",
      "result": "Arena opens and core shield windows become available; wrong panel harmless feedback."
    },
    {
      "id": "P08",
      "room": "REW03",
      "flag": "REWIND_ACQUIRED",
      "goal_clues": "Relic vault requires verified Sluice flow, Survey archive and Reservoir release. Three indicators and symbols correspond to earlier systems.",
      "solution": "Set Sluice=Flow, Survey=Archive, Reservoir=Release; confirm when all three prior flags true.",
      "result": "Relic installed, save immediately; missing inputs identify exact system. Keeper already defeated."
    },
    {
      "id": "P09",
      "room": "REW04",
      "flag": "REWIND_TRAINED",
      "goal_clues": "Safe tutorial: return from one-way switch to starting pad after shutter closes. Ghost trail and prompt show personal path.",
      "solution": "Charge ≥25 EE, walk from pad through shutter to switch within 4 s, activate, press F to rewind to pad.",
      "result": "World switch remains active; next door opens. Reset button restores shutter and gives EE, no progress loss."
    },
    {
      "id": "P10",
      "room": "FOL03",
      "flag": "FOLDS_ALIGNED",
      "goal_clues": "Reconstruct local connections. Three anchor panels show matching geometric halves and stable pulses.",
      "solution": "Connect diamond A to A, split diamond B to B, ring C to C; follow resulting maintenance corridor.",
      "result": "FIN01 accessible; wrong pair gives local mismatch. No extra powers."
    },
